// Music Room v2 data model (spec §6). Order of the queue is never stored:
// it is computed by src/queue/fair-queue.ts on every read.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  USER
}

enum QueueStatus {
  QUEUED
  PLAYING
  PLAYED
  SKIPPED
  REMOVED
}

enum PlaybackStatus {
  IDLE
  PLAYING
  PAUSED
}

model Room {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  settings      Json
  /// scrypt hash of the admin PIN (4–8 digits); null for rooms created before PINs returned
  adminPinHash  String?
  /// L6: the signed-in user who created the room; always admin there
  ownerId       String?
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  /// Last time a person did something in the room (web or Slack); robots (radio, timers) do not count
  lastUsedAt    DateTime       @default(now())
  members       Member[]
  chatLinks     ChatLink[]
  blockedTracks BlockedTrack[]
  queueItems    QueueItem[]
  playback      PlaybackState?
  chatMessages  ChatMessage[]
  activityLogs  ActivityLog[]

  @@index([ownerId, lastUsedAt])
}

model Member {
  id             String      @id @default(cuid())
  roomId         String
  room           Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName    String
  /// lower-cased name; NULL once the member left or was kicked so the name is free again (I-10)
  displayNameKey String?
  color          String
  role           MemberRole  @default(USER)
  isDevice       Boolean     @default(false)
  /// L1: the Google account behind this member (null = guest)
  userId         String?
  /// Đợt 3: the Slack user acting as this member from a linked channel
  slackUserId    String?
  /// The Slack profile picture of slackUserId (refreshed when they act from Slack)
  avatarUrl      String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  canPlay        Boolean     @default(false)
  canControl     Boolean     @default(false)
  canDj          Boolean     @default(false)
  tokenVersion   Int         @default(0)
  leftAt         DateTime?
  kickedAt       DateTime?
  lastSeenAt     DateTime    @default(now())
  lastPlayedAt   DateTime?
  createdAt      DateTime    @default(now())
  queueItems     QueueItem[]
  hearts         Heart[]
  skipVotes      SkipVote[]
  favorites      Favorite[]

  @@unique([roomId, displayNameKey])
  @@index([userId])
  @@index([roomId])
}

model Track {
  id            String         @id
  provider      String
  externalId    String
  title         String
  channel       String?
  durationSec   Int?
  thumbnailUrl  String?
  embeddable    Boolean        @default(true)
  fetchedAt     DateTime       @default(now())
  /// normalizeQuery(title + channel): lets search find known songs without YouTube quota
  searchKey     String?
  /// AI1: artist and song parsed from the title (rules, Last.fm or AI); keys are normalizeQuery()
  artist        String?
  song          String?
  artistKey     String?
  songKey       String?
  /// rules | guess | lastfm | ai — null until the metadata worker has looked at the track
  metaSource    String?
  metaAt        DateTime?
  queueItems    QueueItem[]
  favorites     Favorite[]
  userFavorites UserFavorite[]
  playlistItems PlaylistItem[]
  blockedTracks BlockedTrack[]

  @@index([artistKey])
}

model QueueItem {
  id               String      @id @default(cuid())
  roomId           String
  room             Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trackId          String
  track            Track       @relation(fields: [trackId], references: [id])
  addedById        String?
  addedBy          Member?     @relation(fields: [addedById], references: [id], onDelete: SetNull)
  status           QueueStatus
  pinnedAt         DateTime?
  wishMessage      String?
  voicePreset      String?
  /// Added by the room itself: 'radio' (A4) or 'fallback' (playlist). Null = a member added it.
  auto             String?
  addedAt          DateTime    @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  /// Skip vote (V1): who opened it and when it closes; no new vote before skipBlockedUntil.
  skipVoteById     String?
  skipVoteEndsAt   DateTime?
  skipBlockedUntil DateTime?
  hearts           Heart[]
  skipVotes        SkipVote[]

  @@index([roomId, status])
}

model Heart {
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([queueItemId, memberId])
  @@index([memberId])
}

/// L1: a Google account. Signing in is optional; guests have no User.
model User {
  id           String         @id @default(cuid())
  googleSub    String         @unique
  email        String
  name         String
  picture      String?
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  members      Member[]
  ownedRooms   Room[]
  favorites    UserFavorite[]
  playlists    Playlist[]
}

/// L2: a signed-in user's playlist. shareCode set = anyone with the /p/<code> link can see it.
model Playlist {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  shareCode   String?        @unique
  /// L3: where an imported playlist came from ('yt:liked', 'yt:<playlistId>'); re-import updates it
  source      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PlaylistItem[]

  @@unique([ownerId, source])
  @@index([ownerId, updatedAt])
}

/// L2: a song in a playlist, once per playlist, in `position` order.
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id])
  position   Int
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

/// L1: saved songs of a signed-in user, across rooms and devices.
model UserFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([userId, createdAt])
}

/// "Lưu" (A2): a member's saved songs. Not "Thả tim", which is a vote inside the queue.
model Favorite {
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  createdAt DateTime @default(now())

  @@id([memberId, trackId])
  @@index([memberId, createdAt])
}

model SkipVote {
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// true = ✅ skip it, false = ❌ keep listening (V1).
  approve     Boolean   @default(true)

  @@id([queueItemId, memberId])
}

model PlaybackState {
  roomId         String         @id
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  currentItemId  String?
  status         PlaybackStatus @default(IDLE)
  /// position (seconds) measured at positionAt
  positionSec    Float          @default(0)
  positionAt     DateTime       @default(now())
  version        Int            @default(0)
  playerMemberId String?
}

model ChatMessage {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  memberId    String
  /// copied at send time so history survives renames / kicks
  displayName String
  content     String
  /// "member" or "dj" (the "@DJ" assistant's answer; memberId = "dj")
  kind        String   @default("member")
  /// kind "dj": the DjReply (contracts/dj.ts), worded by each client
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  memberId    String?
  displayName String?
  type        String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
}

model SearchCache {
  key       String   @id
  trackIds  String[]
  /// YouTube had more songs after these ("Xem thêm" can fetch them).
  more      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PlaylistCache {
  playlistId String   @id
  videoIds   String[]
  fetchedAt  DateTime @default(now())
}

/// Đợt 3: a chat channel (Slack first) linked to a room with the admin PIN.
model ChatLink {
  id        String   @id @default(cuid())
  /// "slack" (later "discord", "teams", …)
  platform  String
  /// Workspace / server / tenant id on that platform
  teamId    String
  channelId String
  /// Votes go into this thread of the channel (linked from a thread); null = the channel itself
  threadTs  String?
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([platform, teamId, channelId])
  @@index([roomId])
}

/// A video the room's admin blocked: nobody can add it to that room until unblocked
model BlockedTrack {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trackId       String
  track         Track    @relation(fields: [trackId], references: [id])
  /// The admin's name when they blocked it (members can rename or leave later)
  blockedByName String
  createdAt     DateTime @default(now())

  @@unique([roomId, trackId])
  @@index([roomId])
}
